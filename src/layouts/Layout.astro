---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import "@styles/global.scss";
import SEO, { type PropsSEO } from "@components/Global/SEO.astro";
import Navbar from "@components/Global/Navbar.astro";
import Footer from "@components/Global/Footer.astro";
import { trierTherapies } from "@lib/therapies";

type Props = PropsSEO;

const therapies = trierTherapies(await getCollection("therapies")).map(
  (therapie) => ({
    href: `/therapies/${therapie.id}/`,
    texte: therapie.data.title,
  }),
);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <SEO {...Astro.props} />

    <Font cssVariable="--font-title" preload />
    <Font cssVariable="--font-text" preload />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Navbar />
    <main id="contenu">
      <slot />
    </main>
    <Footer therapies={therapies} />
  </body>
</html>

<style lang="scss">
  // Lien d'évitement : invisible jusqu'à ce qu'on y arrive au clavier.
  .evitement {
    position: absolute;
    top: var(--espace-s);
    left: var(--espace-s);
    z-index: 20;
    padding: var(--espace-s) var(--espace-m);
    border-radius: var(--rayon-s);
    background-color: var(--color-action);
    color: var(--color-action-text);
    transform: translateY(-200%);

    &:focus {
      transform: none;
    }
  }
</style>
