---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import EnTetePage from "@components/UI/EnTetePage.astro";
import Prose from "@components/UI/Prose.astro";
import { formaterDate } from "@lib/date";

type Props = { page: CollectionEntry<"pages"> };

const { page } = Astro.props;
const { Content } = await render(page);
---

<Layout titre={page.data.title} description={page.data.description}>
  <EnTetePage titre={page.data.title}>
    {
      page.data.updated && (
        <p>Mise à jour le {formaterDate(page.data.updated)}</p>
      )
    }
  </EnTetePage>
  <div class="container page-legale">
    <Prose><Content /></Prose>
  </div>
</Layout>

<style lang="scss">
  .page-legale {
    // Pas de marge haute : celle du bas de l'en-tête de page sépare déjà.
    padding-bottom: var(--espace-section);
  }
</style>
