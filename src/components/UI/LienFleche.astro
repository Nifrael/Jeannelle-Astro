---
import Icone from "@components/UI/Icone.astro";

// `retour` : flèche vers la gauche, placée avant le texte (lien vers la page parente).
type Props = { href: string; externe?: boolean; retour?: boolean };

const { href, externe = false, retour = false } = Astro.props;
---

<a
  class:list={["lien-fleche", { "lien-fleche--retour": retour }]}
  href={href}
  target={externe ? "_blank" : undefined}
  rel={externe ? "noopener" : undefined}
>
  {retour && <Icone nom="fleche" />}
  <slot />
  {externe && <span class="visually-hidden">(nouvel onglet)</span>}
  {!retour && <Icone nom={externe ? "lien-externe" : "fleche"} />}
</a>

<style lang="scss">
  @use "@styles/config/mixin" as *;

  .lien-fleche {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-s);
    width: fit-content;
    font-weight: 500;
    text-decoration: none;

    :global(.icone) {
      transition: transform var(--transition);
    }

    @include survol {
      :global(.icone) {
        transform: translateX(3px);
      }
    }
  }

  // La même icône, retournée : pas de second fichier SVG à maintenir.
  .lien-fleche--retour {
    :global(.icone) {
      transform: scaleX(-1);
    }

    @include survol {
      :global(.icone) {
        transform: scaleX(-1) translateX(3px);
      }
    }
  }
</style>
