---
export type Etape = { texte: string; href?: string };

type Props = { etapes: Etape[] };

const { etapes } = Astro.props;
---

<nav class="fil-ariane" aria-label="Fil d'Ariane">
  <ol role="list">
    <li><a href="/">Accueil</a></li>
    {
      etapes.map((etape) => (
        <li>
          {etape.href ? (
            <a href={etape.href}>{etape.texte}</a>
          ) : (
            <span aria-current="page">{etape.texte}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style lang="scss">
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-xs) var(--espace-s);
  }

  li {
    font-size: var(--little-text);
    color: var(--color-text-secondary);

    &:not(:last-child)::after {
      content: "/";
      margin-inline-start: var(--espace-s);
      color: var(--color-accent);
    }
  }

  a {
    color: inherit;
  }
</style>
