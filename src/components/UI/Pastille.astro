---
import Icone, { type NomIcone } from "@components/UI/Icone.astro";

// Avec `href`, la pastille devient un lien : une flèche à droite le signale, et la zone
// à toucher est un peu plus haute.
type Props = { icone?: NomIcone; href?: string };

const { icone, href } = Astro.props;
const Balise = href ? "a" : "span";
---

<Balise href={href} class:list={["pastille", { "pastille--lien": href }]}>
  {icone && <Icone nom={icone} />}
  <slot />
  {href && <Icone nom="fleche" />}
</Balise>

<style lang="scss">
  @use "@styles/config/mixin" as *;

  .pastille {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-xs);
    padding: var(--espace-xs) var(--espace-m);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-pilule);
    background-color: var(--color-bg-cards);
    font-size: var(--little-text);
    font-weight: 500;
    color: var(--color-text);

    :global(.icone) {
      color: var(--color-action);
    }
  }

  .pastille--lien {
    padding-block: var(--espace-s);
    text-decoration: none;
    transition:
      border-color var(--transition),
      color var(--transition);

    @include survol {
      border-color: var(--color-action);
      color: var(--color-action);
    }

    &:focus-visible {
      @include focus-visible;
      border-radius: var(--rayon-pilule);
    }
  }
</style>
