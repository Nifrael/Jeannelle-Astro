---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const categoryLabels = {
  evenement: "Événement",
  conference: "Conférence",
  partenaire: "Partenaire",
  cours: "Cours",
};

const now = new Date();

const entries = await getCollection("actualites", ({ data }) => !data.draft);

// Tri : évènements à venir (au plus proche), puis sans date, puis passés (au plus récent).
const rank = (d) => {
  if (!d.date) return 1; // partenaires / infos permanentes
  return d.date >= now ? 0 : 2;
};

const actualites = entries.sort((a, b) => {
  const ra = rank(a.data);
  const rb = rank(b.data);
  if (ra !== rb) return ra - rb;
  if (a.data.date && b.data.date) {
    return ra === 0
      ? a.data.date.getTime() - b.data.date.getTime()
      : b.data.date.getTime() - a.data.date.getTime();
  }
  return 0;
});

const formatDate = (date) =>
  new Intl.DateTimeFormat("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<section class="news-section" id="actualites">
  <header class="news-header">
    <h2 class="section-title">Actualités & Événements</h2>
    <p class="section-subtitle">
      Rendez-vous, ateliers et rencontres à ne pas manquer chez Jeannelle.
    </p>
  </header>

  <div class="news-grid">
    {
      actualites.map((actu) => {
        const href = actu.data.externalUrl ?? `/actualites/${actu.id}`;
        const isExternal = Boolean(actu.data.externalUrl);
        const isPast = actu.data.date && actu.data.date < now;
        const meta = [
          categoryLabels[actu.data.category],
          actu.data.date &&
            `${isPast ? "Passé · " : ""}${formatDate(actu.data.date)}`,
        ].filter(Boolean);
        return (
          <article class="news-card">
            <div class="news-image-wrapper">
              <Image
                src={actu.data.image}
                alt={actu.data.title}
                class="news-image"
              />
            </div>
            <p class="news-meta">{meta.join(" · ")}</p>
            <h3 class="news-title">{actu.data.title}</h3>
            <p class="news-excerpt">{actu.data.excerpt}</p>
            <a
              href={href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              class="news-link"
            >
              {actu.data.ctaLabel ?? "Lire la suite"}
              <span class="news-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </article>
        );
      })
    }
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .news-section {
    width: 85%;
    max-width: 1200px;
    margin: 4rem auto;
  }

  .news-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    margin: 0;
  }

  .section-subtitle {
    margin: 1rem auto 0 auto;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2.5rem;
    row-gap: 4rem;
  }

  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .news-image-wrapper {
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .news-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .news-meta {
    font-family: var(--text);
    font-size: var(--small-text);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--important-color);
    opacity: 0.6;
    margin: 0 0 0.75rem 0;
  }

  .news-title {
    font-size: var(--h5);
    line-height: 1.4;
    margin: 0 0 0.75rem 0;
  }

  .news-excerpt {
    flex: 1;
    line-height: 1.7;
    margin: 0 0 1.25rem 0;
  }

  .news-link {
    align-self: flex-start;
    font-size: var(--small-text);
    color: var(--important-color);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .news-arrow {
    display: inline-block;
    transition: transform 0.4s ease;
  }

  @include breakpoint-up($breakpoint-tablet) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @include breakpoint-up($breakpoint-desktop) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .news-card:hover {
      .news-arrow {
        transform: translateX(4px);
      }
    }
  }
</style>
