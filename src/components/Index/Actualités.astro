---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const categoryLabels = {
  evenement: "Événement",
  conference: "Conférence",
  partenaire: "Partenaire",
  cours: "Cours",
};

const now = new Date();

const entries = await getCollection("actualites", ({ data }) => !data.draft);

// Tri : évènements à venir (au plus proche), puis sans date, puis passés (au plus récent).
const rank = (d) => {
  if (!d.date) return 1; // partenaires / infos permanentes
  return d.date >= now ? 0 : 2;
};

const actualites = entries.sort((a, b) => {
  const ra = rank(a.data);
  const rb = rank(b.data);
  if (ra !== rb) return ra - rb;
  if (a.data.date && b.data.date) {
    return ra === 0
      ? a.data.date.getTime() - b.data.date.getTime()
      : b.data.date.getTime() - a.data.date.getTime();
  }
  return 0;
});

const formatDate = (date) =>
  new Intl.DateTimeFormat("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<section class="news-section" id="actualites">
  <h2 class="section-title">Actualités & Événements</h2>
  <p class="section-subtitle">
    Rendez-vous, ateliers et rencontres à ne pas manquer chez Jeannelle.
  </p>

  <div class="news-grid">
    {
      actualites.map((actu) => {
        const href = actu.data.externalUrl ?? `/actualites/${actu.id}`;
        const isExternal = Boolean(actu.data.externalUrl);
        const isPast = actu.data.date && actu.data.date < now;
        return (
          <article class="news-card">
            <div class="news-image-wrapper">
              <Image
                src={actu.data.image}
                alt={actu.data.title}
                class="news-image"
              />
              <span class="news-tag">{categoryLabels[actu.data.category]}</span>
            </div>
            <div class="news-card-content">
              {actu.data.date && (
                <p class="news-date">
                  {isPast ? "Passé · " : ""}
                  {formatDate(actu.data.date)}
                </p>
              )}
              <h3>{actu.data.title}</h3>
              <p class="news-excerpt">{actu.data.excerpt}</p>
              <div class="button-container">
                <a
                  href={href}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  class="button"
                >
                  {actu.data.ctaLabel ?? "En savoir plus"}
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .news-section {
    width: 90%;
    max-width: 1200px;
    margin: 5rem auto;
  }

  .section-title {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 3rem auto;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    background-color: var(--white-bg-blur);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0px -1px 3px 3px rgba(207, 154, 113, 0.249);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .news-image-wrapper {
    position: relative;
  }

  .news-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .news-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--text);
    font-size: var(--small-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--white);
    background-color: var(--important-color);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
  }

  .news-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;

    h3 {
      font-size: var(--h5);
      margin: 0 0 0.75rem 0;
    }
  }

  .news-date {
    font-size: var(--small-text);
    color: var(--important-color);
    margin: 0 0 0.5rem 0;
  }

  .news-excerpt {
    flex: 1;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .button-container {
    margin: 0;
    text-align: center;
  }

  @include breakpoint-up($breakpoint-tablet) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @include breakpoint-up($breakpoint-desktop) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .news-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }
  }
</style>
