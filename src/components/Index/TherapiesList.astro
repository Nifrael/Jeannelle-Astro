---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Nature from "@assets/images/Icons/Nature.svg";
import Yin from "@assets/images/Icons/Yin.svg";
import Reflexology from "@assets/images/Icons/Reflexology.svg";
import Chair from "@assets/images/Icons/Chair.svg";
import Brain from "@assets/images/Icons/Brain.svg";
import Hour from "@assets/images/Icons/Hour.svg";

const icons = {
  nature: Nature,
  yin: Yin,
  reflexology: Reflexology,
  chair: Chair,
  brain: Brain,
  hour: Hour,
};

const therapies = (
  await getCollection("therapies", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<section class="therapies-section" id="therapies">
  <h2 class="section-title">Nos thérapies</h2>
  <p class="section-subtitle">
    Des accompagnements pour prendre soin de son corps, de son esprit et de son
    énergie.
  </p>

  <div class="therapies-grid">
    {
      therapies.map((therapie) => (
        <div class="therapie-card">
          <Image
            src={icons[therapie.data.icon]}
            alt=""
            width={52}
            class="therapie-icon"
            aria-hidden="true"
          />
          <h3>{therapie.data.title}</h3>
          <p class="therapie-excerpt">{therapie.data.excerpt}</p>
          <div class="therapie-footer">
            {therapie.data.price && (
              <span class="therapie-price">
                {therapie.data.price}
                {therapie.data.duration && (
                  <span class="therapie-duration">
                    {" "}
                    · {therapie.data.duration}
                  </span>
                )}
              </span>
            )}
            <a href={`/therapies/${therapie.id}`} class="therapie-link">
              Découvrir
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .therapies-section {
    width: 90%;
    max-width: 1200px;
    margin: 5rem auto;
  }

  .section-title {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 3rem auto;
  }

  .therapies-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .therapie-card {
    display: flex;
    flex-direction: column;
    text-align: center;
    background-color: var(--white-bg-blur);
    backdrop-filter: blur(30px);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    box-shadow: 0px -1px 3px 3px rgba(207, 154, 113, 0.249);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;

    h3 {
      color: var(--important-color);
      font-size: var(--h5);
      margin: 1rem 0 0.75rem 0;
    }
  }

  .therapie-icon {
    margin: 0 auto;
  }

  .therapie-excerpt {
    flex: 1;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .therapie-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }

  .therapie-price {
    font-weight: 700;
    color: var(--important-color);
  }

  .therapie-duration {
    font-weight: 400;
    color: var(--text-primary-color);
    font-size: var(--small-text);
  }

  .therapie-link {
    font-family: var(--text);
    color: var(--text-primary-color);
    font-size: var(--small-text);
    transition: color 0.3s ease;
    &:hover {
      color: var(--important-color);
    }
  }

  @include breakpoint-up($breakpoint-tablet) {
    .therapies-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @include breakpoint-up($breakpoint-desktop) {
    .therapies-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
