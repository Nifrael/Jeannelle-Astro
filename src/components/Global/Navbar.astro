---
import { Image } from "astro:assets";
import logo from "@assets/images/logo/jeannelle.png";
import entree from "@assets/images/lieu/entree.jpg";
import { telephone } from "@data/coordonnees";
import Bouton from "@components/UI/Bouton.astro";
import Icone from "@components/UI/Icone.astro";

const liens = [
  { href: "/therapies/", texte: "Thérapies" },
  { href: "/espaces/", texte: "Le lieu" },
  { href: "/actualites/", texte: "Actualités" },
  { href: "/a-propos/", texte: "À propos" },
];

// "page" sur la page exacte, "true" dans une sous-page de la rubrique.
const pageActuelle = Astro.url.pathname;
const ariaCurrent = (href: string) => {
  if (pageActuelle === href) return "page";
  if (pageActuelle.startsWith(href)) return "true";
  return undefined;
};
---

<header class="entete">
  <div class="entete__barre container">
    <a class="logo" href="/">
      <Image
        src={logo}
        alt="Jeannelle, retour à l'accueil"
        width={360}
        loading="eager"
      />
    </a>

    {
      /* Mobile : panneau plein écran. Ordinateur : le panneau s'efface (display: contents) et la nav se centre dans la barre. */
    }
    <div id="menu-principal" class="panneau">
      {
        /* Menu mobile : on « entre » sous l'arche de la porte. Décorative, la photo est déjà décrite sur l'accueil. */
      }
      <Image
        src={entree}
        alt=""
        widths={[320, 480, 640]}
        sizes="16rem"
        class="panneau__arche"
      />
      <nav aria-label="Navigation principale">
        <ul class="liens" role="list">
          {
            liens.map((lien) => (
              <li>
                <a href={lien.href} aria-current={ariaCurrent(lien.href)}>
                  {lien.texte}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Bas du menu mobile uniquement. */}
      <div class="panneau__pied">
        <Bouton href="/contact/" icone="email">Me contacter</Bouton>
        <Image src={logo} alt="" width={240} class="panneau__signature" />
      </div>
    </div>

    <div class="entete__contact">
      <Bouton href="/contact/" icone="email" taille="petite"
        >Me contacter</Bouton
      >
    </div>

    <a class="appel-mobile" href={telephone.lien}>
      <Icone nom="telephone" />
      <span class="visually-hidden">Appeler le {telephone.affiche}</span>
    </a>

    {
      /* « Menu » plutôt que « Ouvrir le menu » : aria-expanded annonce déjà s'il est ouvert. */
    }
    <button
      type="button"
      id="bascule-menu"
      class="bascule"
      aria-controls="menu-principal"
      aria-expanded="false"
    >
      <span class="visually-hidden">Menu</span>
      <span class="bascule__trait" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  import { initNavbar } from "@scripts/navbar";
  initNavbar();
</script>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .entete {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .entete__barre {
    display: flex;
    align-items: center;
    gap: var(--espace-s);
    height: var(--hauteur-entete);
  }

  .logo {
    margin-inline-end: auto;

    img {
      width: 8.5rem;
    }
  }

  // ----- Menu mobile -----

  .panneau {
    position: fixed;
    inset: var(--hauteur-entete) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espace-l);
    padding: var(--espace-l) var(--gouttiere);
    overflow-y: auto;
    background-color: var(--color-bg-secondary);
    text-align: center;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--transition),
      visibility var(--transition);

    &.ouvert {
      visibility: visible;
      opacity: 1;
    }
  }

  // Photo de la porte découpée en arche, comme la voûte en brique de l'entrée.
  .panneau__arche {
    flex-shrink: 0;
    // La hauteur suit celle de l'écran : sur un petit téléphone, le bouton reste visible sans défiler.
    height: min(17.5rem, 28svh);
    width: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px var(--rayon-s) var(--rayon-s);
  }

  .liens {
    display: grid;
    gap: var(--espace-m);

    a {
      font-family: var(--font-title);
      font-size: var(--h3);
      color: var(--color-text);
      text-decoration: none;

      &[aria-current] {
        font-style: italic;
        color: var(--color-action);
      }
    }
  }

  // Légère montée à l'ouverture, sauf si l'utilisateur limite les animations.
  @media (prefers-reduced-motion: no-preference) {
    .panneau__arche,
    .panneau .liens,
    .panneau__pied {
      transform: translateY(0.5rem);
      transition: transform var(--transition);
    }

    .panneau.ouvert .panneau__arche,
    .panneau.ouvert .liens,
    .panneau.ouvert .panneau__pied {
      transform: none;
    }
  }

  .panneau__pied {
    display: grid;
    gap: var(--espace-l);
    justify-items: center;
    margin-top: auto;
  }

  .panneau__signature {
    width: 6rem;
    opacity: 0.6;
  }

  .entete__contact {
    display: none;
  }

  .appel-mobile,
  .bascule {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--rayon-rond);
  }

  .appel-mobile {
    background-color: var(--color-action);
    color: var(--color-action-text);
    font-size: var(--h5);

    @include survol {
      background-color: var(--color-text);
      color: var(--color-action-text);
    }
  }

  .bascule {
    border: 1px solid var(--color-border);
    background: none;
    cursor: pointer;
  }

  // Trois traits dessinés avec un seul élément et ses pseudo-éléments ; croix quand le menu est ouvert.
  .bascule__trait,
  .bascule__trait::before,
  .bascule__trait::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    border-radius: 2px;
    background-color: var(--color-text);
    transition:
      transform var(--transition),
      background-color var(--transition);
  }

  .bascule__trait {
    position: relative;

    &::before,
    &::after {
      content: "";
      position: absolute;
      left: 0;
    }

    &::before {
      transform: translateY(-6px);
    }

    &::after {
      transform: translateY(6px);
    }
  }

  .bascule[aria-expanded="true"] .bascule__trait {
    background-color: transparent;

    &::before {
      transform: rotate(45deg);
    }

    &::after {
      transform: rotate(-45deg);
    }
  }

  // Pas d'appel depuis un ordinateur, même dans une fenêtre étroite.
  @include souris {
    .appel-mobile {
      display: none;
    }
  }

  :global(.menu-ouvert) {
    overflow: hidden;
  }

  // ----- Ordinateur -----

  @include breakpoint-up($breakpoint-desktop) {
    // Trois colonnes : logo à gauche, liens au centre exact, bouton à droite.
    .entete__barre {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: var(--espace-xl);
    }

    .logo {
      margin: 0;

      img {
        width: 10.5rem;
      }
    }

    // `visibility` s'hérite : sans ce rappel, les liens resteraient cachés comme le panneau mobile.
    .panneau {
      display: contents;
      visibility: visible;
    }

    .panneau .liens {
      transform: none;
    }

    .panneau__arche,
    .panneau__pied,
    .appel-mobile,
    .bascule {
      display: none;
    }

    .liens {
      display: flex;
      gap: var(--espace-xl);

      a {
        position: relative;
        padding-block: var(--espace-xs);
        font-family: var(--font-text);
        font-size: var(--p);
        font-weight: 500;

        &[aria-current] {
          font-style: normal;
        }

        &::after {
          content: "";
          position: absolute;
          inset: auto 0 0;
          height: 2px;
          background-color: var(--color-accent);
          transform: scaleX(0);
          transition: transform var(--transition);
        }

        &[aria-current]::after {
          transform: scaleX(1);
        }

        @include survol {
          &::after {
            transform: scaleX(1);
          }
        }
      }
    }

    .entete__contact {
      display: block;
      justify-self: end;
    }
  }
</style>
