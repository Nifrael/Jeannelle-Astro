---
import { Image } from "astro:assets";
import logo from "@assets/images/logo/jeannelle.png";
import { adresse, email, horaires, itineraire } from "@data/coordonnees";
import Icone from "@components/UI/Icone.astro";
import Telephone from "@components/UI/Telephone.astro";

type Lien = { href: string; texte: string };
type Props = { therapies: Lien[] };

const { therapies } = Astro.props;

const pages: Lien[] = [
  { href: "/espaces/", texte: "Le lieu et la location" },
  { href: "/actualites/", texte: "Actualités" },
  { href: "/a-propos/", texte: "À propos" },
  { href: "/contact/", texte: "Contact et accès" },
];
---

<footer class="pied">
  <div class="pied__grille container">
    <div class="pied__marque">
      <Image src={logo} alt="Jeannelle" width={360} />
      <p>
        Centre de thérapeutes au cœur du village de Millas. Un lieu pour se
        poser et être entendu.
      </p>
    </div>

    <section aria-labelledby="pied-contact">
      <h2 id="pied-contact">Nous trouver</h2>
      <ul role="list" class="pied__liste">
        <li>
          <Icone nom="localisation" />
          <span>{adresse.rue}<br />{adresse.codePostal} {adresse.ville}</span>
        </li>
        <li>
          <Icone nom="telephone" />
          <Telephone />
        </li>
        {
          email && (
            <li>
              <Icone nom="email" />
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          )
        }
        <li>
          <Icone nom="horloge" />
          <span>{horaires}</span>
        </li>
      </ul>
      <a
        class="pied__itineraire"
        href={itineraire.url}
        target="_blank"
        rel="noopener"
      >
        Itinéraire<span class="visually-hidden">
          vers Jeannelle sur {itineraire.texte} (nouvel onglet)</span
        >
      </a>
    </section>

    <nav aria-labelledby="pied-therapies">
      <h2 id="pied-therapies">Thérapies</h2>
      <ul role="list" class="pied__liens">
        {
          therapies.map((lien) => (
            <li>
              <a href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="pied-pages">
      <h2 id="pied-pages">Jeannelle</h2>
      <ul role="list" class="pied__liens">
        {
          pages.map((lien) => (
            <li>
              <a href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="pied__bas container">
    <p>&copy; {new Date().getFullYear()} Jeannelle · Karine Maraval</p>
    <ul role="list">
      <li><a href="/mentions-legales/">Mentions légales</a></li>
      <li><a href="/politique-de-confidentialite/">Confidentialité</a></li>
    </ul>
  </div>
</footer>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .pied {
    padding-top: var(--espace-xxl);
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    color: var(--color-text);

    a {
      color: var(--color-text);
      text-decoration: none;

      @include survol {
        color: var(--color-action);
      }
    }

    h2 {
      margin-bottom: var(--espace-m);
      font-family: var(--font-text);
      font-size: var(--little-text);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-accent);
    }

    p,
    li {
      font-size: var(--little-text);
    }
  }

  .pied__grille {
    display: grid;
    gap: var(--espace-xl);
    padding-bottom: var(--espace-xl);
  }

  .pied__marque {
    display: grid;
    align-content: start;
    gap: var(--espace-m);
    max-width: 22rem;

    img {
      width: 10rem;
    }

    p {
      color: var(--color-text-secondary);
    }
  }

  .pied__liste {
    display: grid;
    gap: var(--espace-s);

    li {
      display: flex;
      gap: var(--espace-s);
      align-items: flex-start;
    }

    :global(.icone) {
      margin-top: 0.25em;
      color: var(--color-accent);
    }
  }

  .pied .pied__itineraire {
    display: inline-block;
    margin-top: var(--espace-m);
    text-decoration: underline;
  }

  .pied__liens {
    display: grid;
    gap: var(--espace-s);
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espace-s) var(--espace-l);
    padding-block: var(--espace-l);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);

    ul {
      display: flex;
      gap: var(--espace-l);
    }
  }

  @include breakpoint-up($breakpoint-tablet) {
    .pied__grille {
      grid-template-columns: 1fr 1fr;
    }
  }

  @include breakpoint-up($breakpoint-desktop) {
    .pied__grille {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>
