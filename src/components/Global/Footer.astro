---
import { Image } from "astro:assets";
import logo from "@assets/images/logo/jeannelle.png";
import { adresse, email, horaires, itineraire } from "@data/coordonnees";
import Icone from "@components/UI/Icone.astro";
import Telephone from "@components/UI/Telephone.astro";
import { realisation } from "@data/seo";

type Lien = { href: string; texte: string };
type Props = { therapies: Lien[] };

const { therapies } = Astro.props;

const pages: Lien[] = [
  { href: "/espaces/", texte: "Le lieu et la location" },
  { href: "/actualites/", texte: "Actualités" },
  { href: "/a-propos/", texte: "À propos" },
  { href: "/contact/", texte: "Contact et accès" },
];
---

<footer class="pied">
  <div class="pied__grille container">
    <div class="pied__marque">
      <Image src={logo} alt="Jeannelle" width={360} />
      <p>
        Centre de thérapeutes au cœur du village de Millas. Un lieu pour se
        poser et être entendu.
      </p>
    </div>

    <section aria-labelledby="pied-contact">
      <h2 id="pied-contact">Nous trouver</h2>
      <ul role="list" class="pied__liste">
        <li>
          <Icone nom="localisation" />
          {
            /* L'adresse ouvre l'itinéraire : au téléphone, l'application GPS. */
          }
          <a href={itineraire.url} target="_blank" rel="noopener">
            {adresse.rue}<br />{`${adresse.codePostal} ${adresse.ville}`}
            <span class="visually-hidden">
              (itinéraire sur {itineraire.texte}, nouvel onglet)
            </span>
          </a>
        </li>
        <li>
          <Icone nom="telephone" />
          <Telephone />
        </li>
        {
          email && (
            <li>
              <Icone nom="email" />
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          )
        }
        <li>
          <Icone nom="horloge" />
          <span>{horaires}</span>
        </li>
      </ul>
    </section>

    <nav aria-labelledby="pied-therapies">
      <h2 id="pied-therapies">Thérapies</h2>
      <ul role="list" class="pied__liens">
        {
          therapies.map((lien) => (
            <li>
              <a href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="pied-pages">
      <h2 id="pied-pages">Jeannelle</h2>
      <ul role="list" class="pied__liens">
        {
          pages.map((lien) => (
            <li>
              <a href={lien.href}>{lien.texte}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="pied__bas container">
    <ul role="list" class="pied__legal">
      <li><a href="/mentions-legales/">Mentions légales</a></li>
      <li><a href="/politique-de-confidentialite/">Confidentialité</a></li>
    </ul>
    <p class="pied__credits">
      <span>&copy; {new Date().getFullYear()} Jeannelle</span>
      <span class="pied__auteur">Site développé par {realisation}</span>
    </p>
  </div>
</footer>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .pied {
    padding-top: var(--espace-xl);
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    color: var(--color-text);

    a {
      color: var(--color-text);
      text-decoration: none;

      @include survol {
        color: var(--color-action);
      }
    }

    h2 {
      margin-bottom: var(--espace-m);
      font-family: var(--font-text);
      font-size: var(--little-text);
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-accent);
    }

    p,
    li {
      font-size: var(--little-text);
    }
  }

  .pied__grille {
    display: grid;
    gap: var(--espace-xl);
    padding-bottom: var(--espace-xl);
  }

  .pied__marque {
    display: grid;
    align-content: start;
    gap: var(--espace-m);
    max-width: 22rem;

    img {
      width: 10rem;
    }

    p {
      color: var(--color-text-secondary);
    }
  }

  .pied__liste {
    display: grid;
    gap: var(--espace-s);

    li {
      display: flex;
      gap: var(--espace-s);
      align-items: flex-start;
    }

    :global(.icone) {
      margin-top: 0.25em;
      color: var(--color-accent);
    }
  }

  .pied__liens {
    display: grid;
    gap: var(--espace-s);
  }

  // Deux lignes centrées : les pages légales, puis les crédits.
  .pied__bas {
    display: grid;
    justify-items: center;
    gap: var(--espace-xs);
    text-align: center;
    padding-block: var(--espace-l);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  // Crédits en plus petit. Mobile : le © et la mention sur deux lignes, chacune d'un bloc
  // (la phrase entière ne tient pas à 390 px). Tablette et plus : une seule ligne.
  .pied__bas .pied__credits {
    display: grid;
    font-size: var(--tiny-text);
  }

  .pied__auteur {
    white-space: nowrap;
  }

  // Point médian entre les liens (texte alternatif vide : non lu par les lecteurs d'écran).
  .pied__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;

    li + li::before {
      content: "·" / "";
      margin-inline: var(--espace-s);
    }
  }

  @include breakpoint-up($breakpoint-tablet) {
    .pied__bas .pied__credits {
      display: block;
    }

    .pied__auteur::before {
      content: "·" / "";
      margin-inline: var(--espace-xs);
    }

    .pied__grille {
      grid-template-columns: 1fr 1fr;
    }
  }

  @include breakpoint-up($breakpoint-desktop) {
    .pied {
      padding-top: var(--espace-xxl);
    }

    .pied__grille {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>
