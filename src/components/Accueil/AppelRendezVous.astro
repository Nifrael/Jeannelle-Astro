---
import { Image } from "astro:assets";
import pivoine from "@assets/images/lieu/pivoine.jpg";
import { appel } from "@data/accueil";
import { adresseComplete } from "@data/coordonnees";
import Telephone from "@components/UI/Telephone.astro";
---

<section class="appel" aria-labelledby="appel-titre">
  <Image
    src={pivoine}
    alt=""
    widths={[640, 1280, 1920]}
    sizes="100vw"
    class="appel__fond"
  />
  <div class="container">
    <div class="appel__carte">
      <h2 id="appel-titre">{appel.titre}</h2>
      <p>{appel.texte}</p>
      <Telephone bouton />
      <p class="appel__adresse">
        {adresseComplete} · <a href="/contact/">Plan et accès</a>
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  // Effet « fenêtre » (comme sur linstant-soleana.fr) : la photo reste immobile à l'écran et
  // la section glisse par-dessus. Pas de background-attachment: fixed (cassé sur iOS, repeint à
  // chaque scroll) : la photo est en position: fixed, et clip-path la découpe aux bords de la section.
  .appel {
    position: relative;
    isolation: isolate;
    clip-path: inset(0);
    // Bandeau plus bas qu'une section : c'est une respiration, pas un bloc de contenu.
    padding-block: var(--espace-xxl);

    // Voile sombre entre la photo et la carte : la section se détache du reste de la page.
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: var(--color-voile);
    }
  }

  // lvh : hauteur d'écran barre d'adresse repliée, pour que la photo ne saute pas sur mobile.
  .appel :global(.appel__fond) {
    position: fixed;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100lvh;
    object-fit: cover;
    object-position: 75% center;
  }

  .appel__carte {
    display: grid;
    gap: var(--espace-s);
    justify-items: center;
    max-width: 24rem;
    margin-inline: auto;
    padding: var(--espace-l);
    border-radius: var(--rayon-l);
    background-color: var(--color-bg-cards);
    box-shadow: var(--shadow-s);
    text-align: center;

    // Titre de section, mais à la taille d'un titre de carte : la photo fait déjà l'effet.
    h2 {
      font-size: var(--h4);
    }

    > p:first-of-type {
      color: var(--color-text-secondary);
    }
  }

  .appel__adresse {
    font-size: var(--little-text);
    color: var(--color-text-secondary);
  }

  // Plus large dès la tablette : le texte tient sur moins de lignes, la carte est moins haute.
  @include breakpoint-up($breakpoint-tablet) {
    .appel__carte {
      max-width: 36rem;
    }
  }
</style>
