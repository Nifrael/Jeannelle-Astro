---
import type { CollectionEntry } from "astro:content";
import Icone from "@components/UI/Icone.astro";
import Pastille from "@components/UI/Pastille.astro";
import LienFleche from "@components/UI/LienFleche.astro";
import Telephone from "@components/UI/Telephone.astro";

// `titre` : h3 sous un titre de section (accueil), h2 directement sous le h1 (page Thérapies).
type Props = { therapie: CollectionEntry<"therapies">; titre?: "h2" | "h3" };

const { therapie, titre: Titre = "h3" } = Astro.props;
const { title, icon, schedule, price, duration } = therapie.data;
---

{
  schedule && (
    <aside class="encart" aria-labelledby={`cours-${therapie.id}`}>
      <span class="encart__icone">
        <Icone nom={icon} />
      </span>
      <Titre class="encart__titre" id={`cours-${therapie.id}`}>
        {title}
      </Titre>
      {/* Numéro en lien discret : appel sur mobile, simple texte sur ordinateur. */}
      <p class="encart__reservation">
        Réservation au <Telephone />, {schedule.booking}.
      </p>
      <ul role="list" class="encart__creneaux">
        {schedule.slots.map((creneau) => (
          <li>
            <Pastille icone="horloge">{creneau}</Pastille>
          </li>
        ))}
      </ul>
      <div class="encart__pied">
        {(price || duration) && (
          <p class="encart__infos">
            {price && <span class="encart__prix">{price}</span>}
            {duration && <span>{duration}</span>}
          </p>
        )}
        <LienFleche href={`/therapies/${therapie.id}/`}>
          Découvrir<span class="visually-hidden"> : {title}</span>
        </LienFleche>
      </div>
    </aside>
  )
}

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  // Même construction que les lignes de ListeTherapies (titre, accroche en italique, prix à
  // droite), sur un fond caramel très léger qui signale le cours collectif.
  // Mobile : titre sur toute la largeur et pastille en haut à droite (comme la liste),
  // puis réservation, créneaux, prix et « Découvrir ».
  .encart {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "titre icone"
      "texte texte"
      "creneaux creneaux"
      "pied pied";
    align-items: start;
    gap: var(--espace-s) var(--espace-m);
    margin-bottom: var(--espace-l);
    padding: var(--espace-l);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-l);
    background-color: var(--color-action-soft);
  }

  // Pastille blanche : elle ressort sur le fond caramel de l'encart.
  .encart__icone {
    grid-area: icone;
    display: grid;
    place-items: center;
    padding: var(--espace-s);
    border-radius: var(--rayon-rond);
    background-color: var(--color-bg-cards);
    color: var(--color-action);
    font-size: var(--h4);
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  .encart__titre {
    grid-area: titre;
    font-size: var(--h4);
  }

  .encart__reservation {
    grid-area: texte;
    font-size: var(--base-size);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .encart__creneaux {
    grid-area: creneaux;
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-s);
    margin-top: var(--espace-xs);
  }

  .encart__pied {
    grid-area: pied;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-s) var(--espace-m);
    margin-top: var(--espace-s);
  }

  .encart__infos {
    display: flex;
    align-items: center;
    gap: var(--espace-s);
    font-size: var(--little-text);
    color: var(--color-text-secondary);

    span + span::before {
      content: "·";
      margin-inline-end: var(--espace-s);
    }
  }

  .encart__prix {
    font-size: var(--h5);
    font-weight: 700;
    color: var(--color-action);
  }

  // Même effet que la liste : viser « Découvrir » remplit la pastille.
  @mixin icone-active {
    .encart__icone {
      background-color: var(--color-action);
      color: var(--color-action-text);
    }
  }

  @include souris {
    .encart:has(:global(.lien-fleche):hover) {
      @include icone-active;
    }
  }

  .encart:has(:global(.lien-fleche):focus-visible) {
    @include icone-active;
  }

  // Tablette et plus : prix et « Découvrir » dans une colonne à droite, comme la liste.
  @include breakpoint-up($breakpoint-tablet) {
    .encart {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "icone titre pied"
        "icone texte pied"
        "icone creneaux pied";
      column-gap: var(--espace-l);
      padding: var(--espace-l) var(--espace-xl);
    }

    .encart__pied {
      flex-direction: column;
      align-items: flex-end;
      justify-content: center;
      margin-top: 0;
      padding-inline-start: var(--espace-l);
    }
  }
</style>
