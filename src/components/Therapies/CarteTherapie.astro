---
import type { CollectionEntry } from "astro:content";
import Icone from "@components/UI/Icone.astro";

type Props = { therapie: CollectionEntry<"therapies">; titre?: "h2" | "h3" };

const { therapie, titre: Titre = "h3" } = Astro.props;
const { title, excerpt, icon, price, duration } = therapie.data;
---

<article class="carte">
  <span class="carte__icone"><Icone nom={icon} /></span>
  <Titre class="carte__titre">
    {
      /* Le lien couvre toute la carte (voir ::after) : une seule cible, un seul arrêt au clavier. */
    }
    <a href={`/therapies/${therapie.id}/`}>{title}</a>
  </Titre>
  <p class="carte__texte">{excerpt}</p>
  <p class="carte__infos">
    {price && <span class="carte__prix">{price}</span>}
    {duration && <span>{duration}</span>}
  </p>
</article>

<style lang="scss">
  @use "@styles/config/mixin" as *;

  @mixin mise-en-avant {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-m);
    transform: translateY(-2px);
  }

  .carte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--espace-m);
    padding: var(--espace-l);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-l);
    background-color: var(--color-bg-cards);
    transition:
      box-shadow var(--transition),
      transform var(--transition),
      border-color var(--transition);

    @include survol {
      @include mise-en-avant;
    }

    &:has(:focus-visible) {
      @include mise-en-avant;
    }
  }

  // Icône seule, sans pastille de fond : un peu plus grande pour garder sa présence.
  .carte__icone {
    display: block;
    color: var(--color-action);
    font-size: var(--h3);
    line-height: 0;
  }

  .carte__titre {
    font-size: var(--h4);

    a {
      color: var(--color-text);
      text-decoration: none;

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
      }

      &:focus-visible {
        outline: none;

        &::after {
          outline: 2px solid var(--color-action);
          outline-offset: 3px;
        }
      }
    }
  }

  .carte__texte {
    flex: 1;
    color: var(--color-text-secondary);
  }

  .carte__infos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--espace-s);
    padding-top: var(--espace-m);
    border-top: 1px solid var(--color-border);
    font-size: var(--little-text);
    color: var(--color-text-secondary);

    span + span::before {
      content: "·";
      margin-inline-end: var(--espace-s);
    }
  }

  // Le prix ressort : caramel et gras, un cran au-dessus du texte.
  .carte__prix {
    font-size: var(--h5);
    font-weight: 700;
    color: var(--color-action);
  }
</style>
