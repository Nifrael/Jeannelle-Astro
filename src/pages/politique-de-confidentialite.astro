---
import { getEntry } from "astro:content";
import PageLegale from "@layouts/PageLegale.astro";

const page = await getEntry("pages", "politique-de-confidentialite");
if (!page)
  throw new Error(
    "Contenu manquant : src/content/pages/politique-de-confidentialite.md",
  );
---

<PageLegale page={page} />
