---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import EnTetePage from "@components/UI/EnTetePage.astro";
import Grille from "@components/UI/Grille.astro";
import CarteTherapie from "@components/Therapies/CarteTherapie.astro";
import EncartCours from "@components/Therapies/EncartCours.astro";
import AppelRendezVous from "@components/Accueil/AppelRendezVous.astro";
import {
  coursCollectifs,
  therapiesIndividuelles,
  trierTherapies,
} from "@lib/therapies";

const therapies = trierTherapies(await getCollection("therapies"));
const cours = coursCollectifs(therapies);
const individuelles = therapiesIndividuelles(therapies);
---

<Layout
  titre="Thérapies"
  description="Naturopathie, réflexologie plantaire, yin yoga, massage amma et accompagnement psychocorporel chez Jeannelle à Millas : déroulé, durée et tarifs."
>
  <EnTetePage
    titre="Nos thérapies"
    surtitre="Prendre soin de soi"
  >
    <p>
      Des accompagnements pour prendre soin de son corps, de son esprit et de
      son énergie.
    </p>
  </EnTetePage>
  <div class="container liste">
    {cours.map((therapie) => <EncartCours therapie={therapie} titre="h2" />)}
    <Grille taille="etroite">
      {
        individuelles.map((therapie) => (
          <li>
            <CarteTherapie therapie={therapie} titre="h2" />
          </li>
        ))
      }
    </Grille>
  </div>
  <AppelRendezVous />
</Layout>

<style lang="scss">
  .liste {
    // Pas de marge haute : celle du bas de l'en-tête de page sépare déjà.
    padding-bottom: var(--espace-section);
  }
</style>
