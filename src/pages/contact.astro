---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import EnTetePage from "@components/UI/EnTetePage.astro";
import Bouton from "@components/UI/Bouton.astro";
import Telephone from "@components/UI/Telephone.astro";
import Icone from "@components/UI/Icone.astro";
import {
  adresse,
  email,
  horaires,
  itineraire,
  telephone,
} from "@data/coordonnees";
import entree from "@assets/images/lieu/entree.jpg";
import carte from "@assets/images/lieu/carte-millas.png";
---

<Layout
  titre="Contact et accès"
  description={`Prendre rendez-vous chez Jeannelle : ${telephone.affiche}. ${adresse.rue}, ${adresse.codePostal} ${adresse.ville}.`}
>
  <EnTetePage titre="Contact et accès" surtitre="Prendre rendez-vous">
    <p>
      Les séances ont lieu sur rendez-vous. Le plus simple : un appel, nous
      trouverons ensemble un créneau.
    </p>
  </EnTetePage>

  <div class="contact container">
    <section class="contact__carte" aria-labelledby="coordonnees">
      <h2 id="coordonnees">Coordonnées</h2>
      <ul role="list" class="contact__liste">
        <li>
          <span class="contact__icone"><Icone nom="telephone" /></span>
          <div>
            <h3>Téléphone</h3>
            <Telephone />
          </div>
        </li>
        {
          email && (
            <li>
              <span class="contact__icone">
                <Icone nom="email" />
              </span>
              <div>
                <h3>E-mail</h3>
                <a href={`mailto:${email}`}>{email}</a>
              </div>
            </li>
          )
        }
        <li>
          <span class="contact__icone"><Icone nom="localisation" /></span>
          <div>
            <h3>Adresse</h3>
            <p>{adresse.rue}<br />{adresse.codePostal} {adresse.ville}</p>
          </div>
        </li>
        <li>
          <span class="contact__icone"><Icone nom="horloge" /></span>
          <div>
            <h3>Horaires</h3>
            <p>{horaires}</p>
          </div>
        </li>
      </ul>
    </section>

    {/* Hors de la section Accès pour se placer à côté des coordonnées sur ordinateur. */}
    <Image
      src={entree}
      alt="Façade de Jeannelle : entrée voûtée en pierre et brique, numéro 18"
      widths={[480, 720, 960]}
      sizes="(width >= 1024px) 36rem, 100vw"
      class="contact__photo"
    />

    <section class="acces" aria-labelledby="acces">
      <h2 id="acces">Venir chez Jeannelle</h2>
      {
        /* [À VALIDER] indications d'accès et stationnement à demander à Karine. */
      }
      <p>
        Au cœur du village de Millas : repérez la porte vitrée sous la voûte de
        brique, au numéro 18.
      </p>
      {/* Itinéraire : utile au téléphone (ouvre l'application GPS), masqué sur ordinateur. */}
      <div class="acces__itineraire">
        <Bouton
          href={itineraire.url}
          target="_blank"
          rel="noopener"
          variante="secondaire"
          icone="localisation"
        >
          Lancer l'itinéraire
          <span class="visually-hidden">(nouvel onglet)</span>
        </Bouton>
      </div>

      {
        /* Ordinateur : plan statique (aucun script ni cookie tiers) qui ouvre Google Maps.
           Capture OpenStreetMap désaturée : le crédit est obligatoire (licence ODbL). */
      }
      <figure class="acces__carte">
        <a href={itineraire.url} target="_blank" rel="noopener">
          <Image
            src={carte}
            alt="Plan du centre de Millas : Jeannelle est au 18 rue Lieutenant Basseras, près de la mairie et de l'église"
            widths={[480, 720, 1080, 1440]}
            sizes="(width >= 1024px) 36rem, 100vw"
          />
          <span class="acces__carte-lien">
            Ouvrir dans Google Maps
            <Icone nom="lien-externe" />
            <span class="visually-hidden">(nouvel onglet)</span>
          </span>
        </a>
        <figcaption>
          ©{" "}
          <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener"
          >
            OpenStreetMap
            <span class="visually-hidden">(nouvel onglet)</span>
          </a>
        </figcaption>
      </figure>
    </section>
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .contact {
    display: grid;
    gap: var(--espace-xl);
    // Pas de marge haute : celle du bas de l'en-tête de page sépare déjà.
    padding-bottom: var(--espace-section);
  }

  .contact__carte {
    display: grid;
    gap: var(--espace-l);
    justify-items: start;
    align-self: start;
    padding: var(--espace-carte);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-l);
    background-color: var(--color-bg-cards);
    box-shadow: var(--shadow-s);
  }

  .contact__liste {
    display: grid;
    gap: var(--espace-l);

    li {
      display: flex;
      gap: var(--espace-m);
    }

    h3 {
      font-family: var(--font-text);
      font-size: var(--little-text);
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }

    a {
      font-size: var(--h5);
      font-weight: 500;
    }
  }

  .contact__icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--rayon-rond);
    background-color: var(--color-bg-secondary);
    color: var(--color-action);
    font-size: var(--h5);
  }

  // La classe est posée sur <Image> (composant enfant) : ciblée via :global sous .contact.
  .contact :global(.contact__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--rayon-l);
  }

  .acces {
    display: grid;
    align-content: start;
    gap: var(--espace-m);
  }

  .acces__itineraire {
    @include souris {
      display: none;
    }
  }

  // Plan : seulement sur ordinateur (au téléphone, le bouton d'itinéraire suffit).
  // display: none empêche aussi le téléchargement de l'image (chargement différé).
  .acces__carte {
    display: none;
    gap: var(--espace-s);
    margin: var(--espace-s) 0 0;

    @include souris {
      display: grid;
    }

    // Plan sur toute la largeur, puis une ligne : « Ouvrir dans Google Maps » à gauche,
    // crédit à droite. Le lien partage la grille de la figure (subgrid) pour cela.
    grid-template-columns: 1fr auto;
    column-gap: var(--espace-m);

    > a {
      grid-column: 1 / -1;
      grid-row: 1 / span 2;
      display: grid;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      row-gap: var(--espace-s);
      text-decoration: none;

      img {
        grid-column: 1 / -1;
      }
    }

    // Recadré en 3:2 (le repère est au centre de la capture, il reste au centre).
    img {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border: 1px solid var(--color-border);
      border-radius: var(--rayon-l);
    }

    // Crédit exigé par la licence (forme courte admise par OpenStreetMap), en retrait.
    figcaption {
      grid-column: 2;
      grid-row: 2;
      align-self: center;
      font-size: var(--tiny-text);
      color: var(--color-text-secondary);

      a {
        color: inherit;
      }
    }
  }

  .acces__carte-lien {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-s);
    font-weight: 500;

    :global(.icone) {
      transition: transform var(--transition);
    }
  }

  .acces__carte > a {
    @include survol {
      .acces__carte-lien :global(.icone) {
        transform: translate(2px, -2px);
      }
    }
  }

  // Ordinateur : deux rangées sur les mêmes colonnes. Coordonnées | façade, puis accès | plan.
  @include breakpoint-up($breakpoint-desktop) {
    .contact {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--espace-xxl);
    }

    // La photo prend la hauteur de la carte sans l'imposer : hauteur nulle dans le calcul
    // de la rangée, puis étirée à 100 % de celle-ci.
    .contact :global(.contact__photo) {
      height: 0;
      min-height: 100%;
      aspect-ratio: auto;
      // Recadrage par le bas : l'enseigne, en haut de la photo, reste visible.
      object-position: center top;
    }

    // Sans plan (écran tactile), le texte d'accès prend toute la largeur.
    .acces {
      grid-column: 1 / -1;
    }

    // Avec le plan : texte à gauche, plan à droite, alignés sur les colonnes du dessus.
    @include souris {
      .acces {
        grid-template-columns: subgrid;
        grid-template-rows: auto 1fr;
        column-gap: var(--espace-xxl);

        > :not(.acces__carte) {
          grid-column: 1;
        }
      }

      .acces__carte {
        grid-column: 2;
        grid-row: 1 / -1;
        margin: 0;
      }
    }
  }
</style>
