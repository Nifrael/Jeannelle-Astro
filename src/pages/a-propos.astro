---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import EnTetePage from "@components/UI/EnTetePage.astro";
import Prose from "@components/UI/Prose.astro";
import AppelRendezVous from "@components/Accueil/AppelRendezVous.astro";
import interieur from "@assets/images/a-propos/interieur.jpg";
import portrait from "@assets/images/equipe/karine-maraval-portrait.jpg";
import bougie from "@assets/images/a-propos/bougie.jpg";
import { graphe, personne, urlImage } from "@lib/donnees-structurees";

const page = await getEntry("pages", "a-propos");
const dernierMot = await getEntry("pages", "un-dernier-mot");
const fondatrice = await getEntry("praticiennes", "karine-maraval");
if (!page || !dernierMot || !fondatrice)
  throw new Error("Contenu manquant dans src/content/pages/ ou praticiennes/");

const { Content } = await render(page);
const { Content: ContenuDernierMot } = await render(dernierMot);

const donneesStructurees = graphe(
  personne(
    fondatrice,
    page.data.description,
    Astro.url,
    await urlImage(portrait, Astro.site!),
    Astro.site!,
  ),
);
---

<Layout
  titre="Karine Maraval, infirmière et naturopathe à Millas"
  description={page.data.description}
  image={{ src: portrait, alt: "Karine Maraval" }}
  donneesStructurees={donneesStructurees}
>
  <EnTetePage
    titre="Karine Maraval, fondatrice de Jeannelle"
    surtitre="À propos"
  />

  <figure class="bandeau container">
    <Image
      src={interieur}
      alt="Vue plongeante sur la mezzanine de Jeannelle : parquet, fauteuils et suspensions en rotin"
      widths={[640, 960, 1280, 1600]}
      sizes="(width >= 1152px) 72rem, 100vw"
      loading="eager"
    />
    {
      page.data.citation && (
        <blockquote>
          <p>« {page.data.citation} »</p>
        </blockquote>
      )
    }
  </figure>

  <section class="presentation container" aria-labelledby="qui">
    <div class="presentation__texte">
      <h2 id="qui">{page.data.title}</h2>
      <Prose><Content /></Prose>
    </div>
    <Image
      src={portrait}
      alt="Portrait de Karine Maraval devant un mur de pierre, près d'une lampe de sel"
      widths={[320, 480, 640, 800]}
      sizes="(width >= 1024px) 26rem, 100vw"
      class="presentation__portrait"
    />
  </section>

  {
    page.data.parcours && (
      <section class="parcours" aria-labelledby="parcours-titre">
        <div class="container">
          <h2 id="parcours-titre">Mon parcours</h2>
          <ol role="list" class="parcours__liste">
            {page.data.parcours.map((etape) => (
              <li>{etape}</li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="dernier-mot" aria-labelledby="dernier-mot-titre">
    <Image
      src={bougie}
      alt=""
      widths={[640, 1280, 1920]}
      sizes="100vw"
      class="dernier-mot__fond"
    />
    <div class="container">
      <div class="dernier-mot__carte">
        <h2 id="dernier-mot-titre">{dernierMot.data.title}</h2>
        <ContenuDernierMot />
        {
          dernierMot.data.citation && (
            <p class="dernier-mot__signature">{dernierMot.data.citation}</p>
          )
        }
      </div>
    </div>
  </section>

  <AppelRendezVous />
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .bandeau {
    position: relative;
    margin-top: calc(var(--espace-xl) * -1);

    img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: var(--rayon-l);
    }

    blockquote {
      margin: calc(var(--espace-l) * -1) var(--espace-m) 0;
      position: relative;
      padding: var(--espace-l);
      border-radius: var(--rayon-m);
      background-color: var(--color-bg-cards);
      box-shadow: var(--shadow-m);

      p {
        font-family: var(--font-title);
        font-size: var(--h4);
        font-style: italic;
        color: var(--color-action);
      }
    }
  }

  .presentation {
    display: grid;
    gap: var(--espace-xl);
    padding-block: var(--espace-section);

    h2 {
      margin-bottom: var(--espace-l);
    }
  }

  .presentation__portrait {
    width: 100%;
    max-width: 26rem;
    border-radius: 999px 999px var(--rayon-l) var(--rayon-l);
  }

  // Même fond que .presentation : sa marge basse suffit, sinon les deux s'additionnent.
  .parcours {
    padding-bottom: var(--espace-section);
    background-color: var(--color-bg-secondary);

    h2 {
      margin-bottom: var(--espace-xl);
    }
  }

  // Frise : une ligne verticale et une pastille par étape.
  .parcours__liste {
    display: grid;
    gap: var(--espace-l);
    max-width: var(--largeur-texte);
    border-inline-start: 2px solid var(--color-accent);

    li {
      position: relative;
      padding-inline-start: var(--espace-l);

      &::before {
        content: "";
        position: absolute;
        top: 0.45em;
        left: -0.4375rem;
        width: 0.75rem;
        height: 0.75rem;
        border: 2px solid var(--color-accent);
        border-radius: var(--rayon-rond);
        background-color: var(--color-bg-cards);
      }
    }
  }

  .dernier-mot {
    position: relative;
    isolation: isolate;
    padding-block: var(--espace-section);
  }

  .dernier-mot__fond {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dernier-mot__carte {
    display: grid;
    gap: var(--espace-m);
    max-width: 38rem;
    margin-inline: auto;
    padding: var(--espace-xl) var(--espace-l);
    border-radius: var(--rayon-l);
    background-color: var(--color-bg-translucent);
    backdrop-filter: blur(20px);
    text-align: center;
  }

  .dernier-mot__signature {
    font-family: var(--font-title);
    font-size: var(--h3);
    font-style: italic;
    color: var(--color-action);
  }

  @include breakpoint-up($breakpoint-tablet) {
    .bandeau {
      img {
        aspect-ratio: 21 / 9;
      }

      blockquote {
        position: absolute;
        right: var(--espace-xl);
        bottom: var(--espace-xl);
        max-width: 26rem;
        margin: 0;
      }
    }
  }

  @include breakpoint-up($breakpoint-desktop) {
    .presentation {
      grid-template-columns: 1fr 26rem;
      gap: var(--espace-xxl);
      align-items: start;
    }

    .presentation__portrait {
      position: sticky;
      top: calc(var(--hauteur-entete) + var(--espace-l));
    }

    .dernier-mot__carte {
      padding: var(--espace-xxl);
    }
  }
</style>
