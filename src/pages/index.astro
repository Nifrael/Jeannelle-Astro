---
import { getCollection, getEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Accueil/Hero.astro";
import Presentation from "@components/Accueil/Presentation.astro";
import ApercuEspaces from "@components/Accueil/ApercuEspaces.astro";
import AppelRendezVous from "@components/Accueil/AppelRendezVous.astro";
import CarteTherapie from "@components/Therapies/CarteTherapie.astro";
import CarteActualite from "@components/Actualites/CarteActualite.astro";
import CartePraticienne from "@components/Equipe/CartePraticienne.astro";
import EnTeteSection from "@components/UI/EnTeteSection.astro";
import Grille from "@components/UI/Grille.astro";
import LienFleche from "@components/UI/LienFleche.astro";
import {
  actualites as texteActualites,
  equipe,
  therapies as texteTherapies,
} from "@data/accueil";
import { descriptionParDefaut, nomDuSite, partageParDefaut } from "@data/seo";
import { etablissementLocal } from "@lib/donnees-structurees";
import { trierActualites } from "@lib/actualites";
import { trierTherapies } from "@lib/therapies";
import { getImage } from "astro:assets";

const aPropos = await getEntry("pages", "a-propos");
const citation = aPropos?.data.citation;
if (!citation)
  throw new Error("Citation manquante dans src/content/pages/a-propos.md");

const therapies = trierTherapies(await getCollection("therapies"));
const actualites = trierActualites(await getCollection("actualites")).slice(
  0,
  3,
);
const praticiennes = (await getCollection("praticiennes")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

const imagePartage = await getImage({
  src: partageParDefaut.src,
  width: 1200,
  format: "jpg",
});
const donneesStructurees = etablissementLocal(
  Astro.site!,
  new URL(imagePartage.src, Astro.site).href,
);
---

<Layout
  titre={nomDuSite}
  description={descriptionParDefaut}
  donneesStructurees={donneesStructurees}
>
  <Hero citation={citation} />
  <Presentation />

  <section class="section section--teinte" aria-labelledby="therapies-titre">
    <div class="container">
      <EnTeteSection
        id="therapies-titre"
        surtitre={texteTherapies.surtitre}
        titre={texteTherapies.titre}
      />
      <Grille taille="etroite">
        {
          therapies.map((therapie) => (
            <li>
              <CarteTherapie therapie={therapie} />
            </li>
          ))
        }
      </Grille>
    </div>
  </section>

  <ApercuEspaces />

  <section class="section" aria-labelledby="equipe-titre">
    <div class="container">
      <EnTeteSection id="equipe-titre" titre={equipe.titre} centre />
    </div>
    <ul role="list" class="equipe">
      {
        praticiennes.map((praticienne) => (
          <li>
            <CartePraticienne praticienne={praticienne} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section section--teinte" aria-labelledby="actualites-titre">
    <div class="container">
      <div class="section__entete">
        <EnTeteSection
          id="actualites-titre"
          surtitre={texteActualites.surtitre}
          titre={texteActualites.titre}
        />
        <LienFleche href="/actualites/">Toutes les actualités</LienFleche>
      </div>
      <Grille>
        {
          actualites.map((actualite) => (
            <li>
              <CarteActualite actualite={actualite} />
            </li>
          ))
        }
      </Grille>
    </div>
  </section>

  <AppelRendezVous />
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .section {
    padding-block: var(--espace-section);
  }

  .section--teinte {
    background-color: var(--color-bg-secondary);
  }

  // Mobile : les cartes défilent à l'horizontale, la suivante dépasse pour inviter à glisser.
  // Grand écran : elles se rangent côte à côte, centrées.
  .equipe {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 20rem);
    gap: var(--espace-m);
    overflow-x: auto;
    padding-inline: var(--gouttiere);
    padding-bottom: var(--espace-s);
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gouttiere);
    scrollbar-width: none;

    li {
      scroll-snap-align: start;
    }
  }

  @include breakpoint-up($breakpoint-tablet) {
    .equipe {
      justify-content: center;
      gap: var(--espace-l);
    }
  }

  .section__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 var(--espace-l);
    margin-bottom: var(--espace-xl);

    :global(.en-tete) {
      margin-bottom: var(--espace-m);
    }
  }
</style>
