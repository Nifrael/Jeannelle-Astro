---
import { getCollection, getEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Accueil/Hero.astro";
import Presentation from "@components/Accueil/Presentation.astro";
import ApercuEspaces from "@components/Accueil/ApercuEspaces.astro";
import AppelRendezVous from "@components/Accueil/AppelRendezVous.astro";
import ListeTherapies from "@components/Therapies/ListeTherapies.astro";
import EncartCours from "@components/Therapies/EncartCours.astro";
import CarteActualite from "@components/Actualites/CarteActualite.astro";
import CartePraticienne from "@components/Equipe/CartePraticienne.astro";
import EnTeteSection from "@components/UI/EnTeteSection.astro";
import Grille from "@components/UI/Grille.astro";
import LienFleche from "@components/UI/LienFleche.astro";
import {
  actualites as texteActualites,
  equipe,
  therapies as texteTherapies,
} from "@data/accueil";
import {
  descriptionParDefaut,
  titreAccueil,
  partageParDefaut,
} from "@data/seo";
import { etablissementLocal, graphe, urlImage } from "@lib/donnees-structurees";
import { trierActualites } from "@lib/actualites";
import {
  coursCollectifs,
  therapiesIndividuelles,
  trierTherapies,
} from "@lib/therapies";

const aPropos = await getEntry("pages", "a-propos");
const citation = aPropos?.data.citation;
if (!citation)
  throw new Error("Citation manquante dans src/content/pages/a-propos.md");

const therapies = trierTherapies(await getCollection("therapies"));
const cours = coursCollectifs(therapies);
const individuelles = therapiesIndividuelles(therapies);
const actualites = trierActualites(await getCollection("actualites")).slice(
  0,
  3,
);
const praticiennes = (await getCollection("praticiennes")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

const donneesStructurees = graphe(
  etablissementLocal(
    Astro.site!,
    await urlImage(partageParDefaut.src, Astro.site!),
  ),
);
---

<Layout
  titre={titreAccueil}
  description={descriptionParDefaut}
  donneesStructurees={donneesStructurees}
>
  <Hero citation={citation} />
  <Presentation />

  <section class="section section--teinte" aria-labelledby="therapies-titre">
    <div class="container">
      <EnTeteSection
        id="therapies-titre"
        surtitre={texteTherapies.surtitre}
        titre={texteTherapies.titre}
      />
      {cours.map((therapie) => <EncartCours therapie={therapie} />)}
      <ListeTherapies therapies={individuelles} />
    </div>
  </section>

  <ApercuEspaces />

  <section class="section" aria-labelledby="equipe-titre">
    <div class="container">
      <EnTeteSection id="equipe-titre" titre={equipe.titre} centre />
      <ul role="list" class="equipe">
        {
          praticiennes.map((praticienne) => (
            <li>
              <CartePraticienne praticienne={praticienne} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="actualites-titre">
    <div class="container">
      <div class="section__entete">
        <EnTeteSection
          id="actualites-titre"
          surtitre={texteActualites.surtitre}
          titre={texteActualites.titre}
        />
        <LienFleche href="/actualites/">Toutes les actualités</LienFleche>
      </div>
      <Grille>
        {
          actualites.map((actualite) => (
            <li>
              <CarteActualite actualite={actualite} />
            </li>
          ))
        }
      </Grille>
    </div>
  </section>

  <AppelRendezVous />
</Layout>

<style lang="scss">
  .section {
    padding-block: var(--espace-section);
  }

  // Deux sections de suite sur le même fond : un seul espacement entre elles, pas deux.
  .section:not(.section--teinte) + .section:not(.section--teinte) {
    padding-top: 0;
  }

  .section--teinte {
    background-color: var(--color-bg-secondary);
  }

  // Cartes de 20rem au plus : empilées sur mobile, côte à côte et centrées dès que la place le permet.
  // Rien ne dépasse de l'écran (pas de défilement horizontal).
  .equipe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 20rem));
    justify-content: center;
    gap: var(--espace-l);
  }

  .section__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 var(--espace-l);
    margin-bottom: var(--espace-xl);

    :global(.en-tete) {
      margin-bottom: var(--espace-m);
    }
  }
</style>
